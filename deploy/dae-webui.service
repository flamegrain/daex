[Unit]
Description=dae-webui (production)
After=network-online.target dae.service

[Service]
Type=simple
User=root
# 当前阶段按项目规则使用假数据。切换到真实配置需显式决定:
#   -dae-config /usr/local/etc/dae/config.dae -allow-system-config
ExecStart=/usr/local/bin/dae-webui -listen 0.0.0.0:9091 -dae-config /opt/dae-webui/config.mock.dae
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
