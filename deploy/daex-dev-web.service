[Unit]
Description=daex DEV frontend (Vite HMR, :5173)
After=network-online.target daex-dev-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/daex/frontend
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/share/pnpm
ExecStart=/usr/local/bin/pnpm dev --host 0.0.0.0
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
